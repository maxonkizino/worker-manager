# Локальные настройки. Config Server не используется.
# Spring Boot читает эти переменные, если они попали в окружение процесса.
# Docker Compose подставляет JWT_SECRET отсюда сам.

DB_HOST=localhost
DB_PORT=5433
DB_USER=taskflow
DB_PASSWORD=taskflow

JWT_SECRET=taskflow-local-jwt-secret-key-min-32-chars!!

KAFKA_BOOTSTRAP=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379

EUREKA_CLIENT_ENABLED=false
